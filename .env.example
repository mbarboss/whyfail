# whyfail reads these from the process environment; it never loads a .env file.
# Flags take precedence over environment variables.

# Ollama model used to explain failures.
WHYFAIL_MODEL=
# Ollama server URL. Non-loopback hosts are refused unless --allow-remote is passed.
OLLAMA_HOST=http://127.0.0.1:11434
# Maximum time to wait for an answer (Go duration syntax).
WHYFAIL_TIMEOUT=60s
