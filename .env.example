# whyfail reads these from the process environment; it never loads a .env file.
# Flags take precedence over environment variables.

# Ollama model used to explain failures (default gemma4:e4b).
WHYFAIL_MODEL=
# Ollama server URL. The captured command output is sent here. Hosts that are not on
# this machine are refused unless --allow-remote is passed (there is no variable for it).
OLLAMA_HOST=http://127.0.0.1:11434
# Maximum time to wait for an answer (Go duration syntax).
WHYFAIL_TIMEOUT=2m
